# Pinned versions for the motivation study. Source this file in every setup and
# run script; each run copies it next to its results.
#
# Dynamo: v1.6.2 (2026-11-05) is the latest stable release and the last line that
# still ships the KV Block Manager. KVBM was deprecated in v1.5.0 and its removal
# is targeted for v1.7.0 (the 1.7.0 dev builds already exist). The newest KVBM
# packages are the 1.6.1 `kvbm` wheel and the kvbm-* crates on crates.io.
# Mode A (this paper) does not use KVBM: the LLM is a remote, opaque service.
DYNAMO_VERSION=1.6.2
KVBM_WHEEL_VERSION=1.6.1   # install only if you want KVBM on the LLM host; not needed here

# Remote LLM (A100-DGX, 80 GB): one replica per GPU, TP=1, BF16.
LLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
LLM_TOOL_PARSER=qwen3_coder
LLM_MAX_MODEL_LEN=65536
LLM_HTTP_PORT=8000

# Harness-side LLM proxy (x86 harness host): logs request timing, forwards to Dynamo.
PROXY_PORT=8001

# Harnesses and tool libraries. Commits are recorded at install time in
# results/<run>/env/*.txt; pin here once the first install succeeds.
MINI_SWE_AGENT_REF=main
KERNELBENCH_REF=main
CHEMGRAPH_REF=main
MACE_MODEL=medium-mpa-0          # ChemGraph's default mace_mp model
CHEMGRAPH_MCP_PORT=9003

# Tool host runtime
CUDA_CHECKPOINT_REF=main         # NVIDIA/cuda-checkpoint; needs driver >= 570 for --action
CRIU_MIN_VERSION=4.0             # 4.0+ has the CUDA plugin
SAMPLE_HZ=10                     # NVML sampling rate
